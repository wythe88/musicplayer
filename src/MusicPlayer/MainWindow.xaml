<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicPlayer" Height="800" Width="1320" MinHeight="650" MinWidth="1000"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="VOLUME" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0"/>
                <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="80"
                        ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MusicPlayer" FontSize="23" FontWeight="SemiBold" Margin="0,0,22,0"/>
                <Button Content="添加媒体" Click="AddMedia_Click"/>
                <Button Content="▶ 播放" Click="PlaySelected_Click"/>
                <Button Content="Ⅱ 暂停" Click="Pause_Click"/>
                <Button Content="■ 停止" Click="Stop_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="正在播放" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PlaybackStatusText" DockPanel.Dock="Right" Text="就绪" Foreground="{StaticResource MutedText}"/>
                </DockPanel>
                <Border Grid.Row="1" Background="#121821" CornerRadius="6" Margin="0,9,0,8" ClipToBounds="True">
                    <Canvas x:Name="WaveformCanvas" Background="Transparent" Height="105"
                            MouseLeftButtonDown="Waveform_MouseLeftButtonDown"
                            MouseMove="Waveform_MouseMove"
                            MouseLeftButtonUp="Waveform_MouseLeftButtonUp"
                            SizeChanged="WaveformCanvas_SizeChanged"/>
                </Border>
                <DockPanel Grid.Row="2">
                    <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurrentTrackText" Text="尚未播放" Foreground="{StaticResource PrimaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                    <TextBlock x:Name="DurationText" Text="00:00" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="＋ 新建播放列表" Click="NewPlaylist_Click" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="播放列表" FontSize="16" FontWeight="SemiBold" Margin="4,2,4,12"/>
                        <ListBox x:Name="PlaylistList" SelectionChanged="PlaylistList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource PrimaryText}" DisplayMemberPath="Name">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重命名播放列表" Click="RenamePlaylist_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <StackPanel>
                            <TextBlock x:Name="CurrentPlaylistTitle" Text="媒体" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MediaCountText" Text="0 个媒体" Foreground="{StaticResource MutedText}" FontSize="12"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="导入媒体" Click="AddMedia_Click"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MediaItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}"
                                            Background="{StaticResource CardBackground}" CornerRadius="8"
                                            BorderBrush="#3A4656" BorderThickness="1" Margin="5" Padding="10"
                                            MouseLeftButtonDown="MediaCard_MouseLeftButtonDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="播放" Click="MediaPlay_Click"/>
                                                <MenuItem Header="浏览文件位置" Click="RevealMedia_Click"/>
                                                <Separator/>
                                                <MenuItem Header="复制" Click="CopyMedia_Click"/>
                                                <MenuItem Header="粘贴" Click="PasteMedia_Click"/>
                                                <MenuItem Header="重命名" Click="RenameMedia_Click"/>
                                                <MenuItem Header="编辑 / 剪辑" Click="TrimMedia_Click"/>
                                                <Separator/>
                                                <MenuItem Header="删除媒体" Click="RemoveMedia_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="7" Background="#314B55" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="♫" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       MaxHeight="42" ToolTip="{Binding FullPath}"/>
                                            <TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,2,0">
            <TextBlock Text="媒体卡片大小" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Slider x:Name="CardZoomSlider" Width="170" Minimum="0" Maximum="100" Value="50"
                    ValueChanged="CardZoomSlider_ValueChanged" Margin="10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ZoomValueText" Text="100%" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
