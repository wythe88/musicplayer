<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicPlayer" Height="780" Width="1280" MinHeight="620" MinWidth="980"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="VOLUME" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0"/>
                <Slider Width="110" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MusicPlayer" FontSize="23" FontWeight="SemiBold" Margin="0,0,22,0"/>
                <Button Content="添加媒体" Click="AddMedia_Click"/>
                <Button Content="播放" Click="PlaybackPlaceholder_Click"/>
                <Button Content="暂停" Click="PlaybackPlaceholder_Click"/>
                <Button Content="停止" Click="PlaybackPlaceholder_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="波形 / 播放定位" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" Text="音频引擎尚未接入" Foreground="{StaticResource MutedText}"/>
                </DockPanel>
                <Border Grid.Row="1" Background="#121821" CornerRadius="6" Margin="0,10,0,8">
                    <Grid>
                        <TextBlock Text="波形将在音频解码接入后生成" Foreground="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2">
                    <TextBlock Text="00:00" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <Slider Margin="10,0" Minimum="0" Maximum="100" IsEnabled="False"/>
                    <TextBlock Text="00:00" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="＋ 新建播放列表" Click="NewPlaylist_Click" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="播放列表" FontSize="16" FontWeight="SemiBold" Margin="4,2,4,12"/>
                        <ListBox x:Name="PlaylistList" SelectionChanged="PlaylistList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource PrimaryText}" DisplayMemberPath="Name"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <StackPanel>
                            <TextBlock x:Name="CurrentPlaylistTitle" Text="媒体" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MediaCountText" Text="0 个媒体" Foreground="{StaticResource MutedText}" FontSize="12"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="导入媒体" Click="AddMedia_Click"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MediaItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}"
                                            Background="{StaticResource CardBackground}" CornerRadius="8"
                                            BorderBrush="#3A4656" BorderThickness="1" Margin="5" Padding="10">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="播放" Click="MediaPlay_Click"/>
                                                <MenuItem Header="浏览文件位置" Click="RevealMedia_Click"/>
                                                <Separator/>
                                                <MenuItem Header="复制" Click="CopyMedia_Click"/>
                                                <MenuItem Header="粘贴" Click="PasteMedia_Click"/>
                                                <MenuItem Header="重命名" Click="RenameMedia_Click"/>
                                                <MenuItem Header="编辑 / 剪辑" Click="TrimMedia_Click"/>
                                                <Separator/>
                                                <MenuItem Header="删除媒体" Click="RemoveMedia_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="7" Background="#314B55" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="♫" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       MaxHeight="42" ToolTip="{Binding FullPath}"/>
                                            <TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,2,0" LastChildFill="False">
            <TextBlock Text="媒体卡片大小" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Slider x:Name="CardZoomSlider" Width="170" Minimum="0" Maximum="100" Value="50"
                    ValueChanged="CardZoomSlider_ValueChanged" Margin="10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ZoomValueText" Text="100%" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
